---

<section class="hero">
    <div class="container">
        <div class="hero-picture">
            <picture>
                <source srcset="/hero/main.avif" type="image/avif">
                <source srcset="/hero/main.webp" type="image/webp">
                <img src="/hero/main.jpg" alt="Hero Description" class="hero-img">
            </picture>
        </div>
        <h1>
            თაიგულები ყველა მომენტისთვის
        </h1>
    </div>
</section>

<style>
    .hero {
        padding: 50px 0;
    }

    .hero-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 500px;
        object-fit: cover;
        z-index: -1;
    }

    h1 {
        font-family: 'AnaKalandadze', sans-serif;
        font-weight: 400;
        font-size: 30px;
        text-align: center;
        color: #fff;
        padding-bottom: 100px;;
    }
</style>