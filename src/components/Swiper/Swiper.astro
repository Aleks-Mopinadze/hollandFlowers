---
import BannerCarousel from "./BannerSwiper/BannerCarousel.astro";
import CardCarousel from "./CardSwiper/CardCarousel.astro";
import NavigationCarousel from "./NavigationSwiper/Navigation.astro";


type CarouselType = 'banner' | 'card' | 'navigation';


interface CarouselItem {
    title: string;
    image?: string;
    link?: string;
}

interface Props {
    type: CarouselType,
    items: CarouselItem[],
}

const {type, items}  = Astro.props;

const CAROUSEL_COMPONENTS = {
    banner: BannerCarousel,
    card: CardCarousel,
    navigation: NavigationCarousel,
}

const Element = CAROUSEL_COMPONENTS[type] || CardCarousel

---

<Element items={items} />

