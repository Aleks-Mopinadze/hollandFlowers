---
import Swiper from "./Swiper/Swiper.astro";

const data = [
    {
    title: 'მიყვარხარ ♥ '
    },
    {
    title: 'მიყვარხარ ♥'
    },
    {
    title: 'მიყვარხხარ ♥'
    }
]
---

<header class="header">
    <Swiper items={data} type="banner"/>
    <div class="container">
        <div class="menu">
            <button class="menu-btn" aria-label="Open navigation menu" >
                <svg width="30px" height="30px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"
                     aria-hidden="true" focusable="false"
                >
                    <path d="M4 18H10" stroke="#000" stroke-width="2" stroke-linecap="round"/>
                    <path d="M4 12L16 12" stroke="#000" stroke-width="2" stroke-linecap="round"/>
                    <path d="M4 6L20 6" stroke="#000" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </button>
        </div>

        <a href="/" class="logo">
            <img src="/logo.jpg" alt="Dutch Flowers home">
        </a>

        <div class="action">
            <div class="contact">
                <a href="tel:+995593178817" class="phone">
                    +995 593 17 88 17
                </a>
                <a href="tel:+995593178817" class="phone">
                    +995 592 15 04 42
                </a>
            </div>
            <div class="cart">
                <svg width="33" height="33" viewBox="0 0 33 33" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M24.0625 8.25H8.9375C7.79841 8.25 6.875 9.17341 6.875 10.3125V26.8125C6.875 27.9516 7.79841 28.875 8.9375 28.875H24.0625C25.2016 28.875 26.125 27.9516 26.125 26.8125V10.3125C26.125 9.17341 25.2016 8.25 24.0625 8.25Z" stroke="#000" stroke-width="2" stroke-linejoin="round" />
                    <path d="M20.625 12.375V6.875C20.625 4.59682 18.7782 2.75 16.5 2.75C14.2218 2.75 12.375 4.59682 12.375 6.875V12.375" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="cart-count">2</span>
            </div>
        </div>
    </div>
</header>

<style>
    header {
        background-color: white;
        border-bottom: 1px solid #e1e1e1;
    }

    .container {
        padding: 10px 5px;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        align-items: center;
    }

    .menu-btn {
        background: transparent;
        border: none;
        &:hover {
            cursor: pointer;
        }
    }

    .logo {
        justify-self: center;
        img {
            height: 70px;
        }
    }

    .action {
        width: 140px;
        justify-self: end;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .phone {
        font-size: 12px;
        font-weight: bold;
        text-decoration: none;
        display: inline-block;
        margin-right: 5px;
        color: #4a1c1c;

    }

    .cart {
        position: relative;
    }

    .cart-count {
        width: 15px;
        height: 15px;
        font-size: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background-color: #6e3e3e;
        color: white;
        position: absolute;
        right: 0;
        top: 0;
    }

</style>