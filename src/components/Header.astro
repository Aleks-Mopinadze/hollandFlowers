---
import Swiper from "./Swiper/Swiper.astro";

const data = [
    {
    title: 'მიყვარხარ ♥ '
    },
    {
    title: 'მიყვარხარ ♥'
    },
    {
    title: 'მიყვარხხარ ♥'
    }
]
---

<header class="header">
    <Swiper items={data} type="banner"/>
    <div class="container">
        <div class="menu">
            <button class="menu-btn" aria-label="Open navigation menu" >
                <svg width="30px" height="30px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"
                     aria-hidden="true" focusable="false"
                >
                    <path d="M4 18H10" stroke="#000" stroke-width="2" stroke-linecap="round"/>
                    <path d="M4 12L16 12" stroke="#000" stroke-width="2" stroke-linecap="round"/>
                    <path d="M4 6L20 6" stroke="#000" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </button>
        </div>

        <a href="/" class="logo">
            <img src="/logo.jpg" alt="Dutch Flowers home">
        </a>

        <div class="action">
            <div class="contact">
                <a href="tel:+995593178817" class="phone">
                    +995 593 17 88 17
                </a>
                <a href="tel:+995593178817" class="phone">
                    +995 592 15 04 42
                </a>
            </div>
            <div class="cart">
                <img src="/cart/cart-24.gif" alt="Cart">
            </div>
        </div>
    </div>
</header>

<style>
    header {
        background-color: white
    }

    .container {
        padding: 10px 5px;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        align-items: center;
    }

    .menu-btn {
        background: transparent;
        border: none;
        &:hover {
            cursor: pointer;
        }
    }

    .logo {
        justify-self: center;
        img {
            height: 70px;
        }
    }

    .action {
        width: 130px;
        justify-self: end;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .phone {
        font-size: 12px;
        font-weight: bold;
        text-decoration: none;
        display: inline-block;
        margin-right: 5px;
        color: #4a1c1c;

    }

    .cart {
        margin-right: 5px;
    }

</style>